# Robinhood Credentials
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password
# Optional: TOTP secret for 2FA (base32 encoded)
ROBINHOOD_TOTP=

# Bot Settings
CHECK_INTERVAL_MINUTES=15

# ── Autonomous stock trader (autotrade.py) ──────────────────────
# Free keys: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_API_SECRET=
# true = paper trading (fake money). Live trading also needs the --live flag.
ALPACA_PAPER=true

# Dollars spent on each trade, and max positions held at once
TRADE_AMOUNT=1000
MAX_POSITIONS=3
# Sell when up this % (profit) or down this % (stop loss)
TAKE_PROFIT_PCT=4
STOP_LOSS_PCT=2
# Only consider stocks up between these % today, priced in this range
MIN_GAIN_PCT=5
MAX_GAIN_PCT=30
MIN_PRICE=5
MAX_PRICE=500
MIN_VOLUME=500000
# Momentum score (0-100) required to buy
MIN_SCORE=60
# Stop opening trades for the day after losing this % of equity
MAX_DAILY_LOSS_PCT=3
# Sell everything this many minutes before the close (0 = hold overnight)
FLATTEN_MINUTES_BEFORE_CLOSE=10
SKIP_FIRST_MINUTES=15
SKIP_LAST_MINUTES=30
SCAN_INTERVAL_SECONDS=60
